# ---------------------------------------------------------------------------
# vulkangears - what must never end up in the repository
#
# Everything ignored here is either fetched or generated.  A fresh clone should
# build from the tracked sources alone:
#     ./scripts/fetch_deps.sh                                   (Linux, no root)
#     cmake -S . -B build && cmake --build build -j
# ---------------------------------------------------------------------------

# --- fetched dependencies --------------------------------------------------
# scripts/fetch_deps.sh unpacks the missing -dev packages here (Vulkan headers,
# GLFW, glslangValidator, validation layers).  Large binaries - never commit.
/third_party/

# --- build output ---------------------------------------------------------
# The CMake build directory (cmake -S . -B build).  In-source builds are
# refused by CMakeLists.txt; /generated/ is kept as a belt-and-braces guard in
# case one is ever forced through.
/build/
/generated/

# --- program output -------------------------------------------------------
# --headless writes a PPM (vulkangears.ppm by default, in the current dir).
*.ppm
*.log

# --- the MCP screenshot server --------------------------------------------
# .mcp/screenshot/ is tracked on purpose: it is small, and tracking it is what
# lets .vscode/mcp.json refer to it without a single absolute path. Only the
# private virtualenv and the bytecode caches are ignored -- setup.ps1 rebuilds
# the venv after a clone.
.mcp/screenshot/.venv/
# setup.sh keeps the 2 MB get-pip.py it downloads here so that a rebuild does not
# need the network a second time. Fetched, not source.
.mcp/screenshot/.pip-bootstrap/
__pycache__/
*.pyc

# --- compiler and CMake leftovers -----------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.spv
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt
compile_commands.json
build.ninja
rules.ninja
.ninja_deps
.ninja_log

# --- editors, IDEs and OS cruft -------------------------------------------
.vs/
# Everything under .vscode/ is personal, including mcp.json. That file used to be
# tracked so a fresh clone got the screenshot tools, but it cannot hold a working
# value on both Windows and Linux: a venv keeps its interpreter in bin/ on one and
# Scripts/ on the other, and the MCP schema has no per-platform conditional (unlike
# launch.json). Each setup script writes it instead, from the interpreter it just
# built -- see .mcp/screenshot/write_mcp_config.py -- and it stays out of the
# repository so one platform's answer is never committed over the other's.
# Note this ignores the directory's *contents* rather than the directory: git does
# not descend into an excluded directory, so a negation for a file inside one never
# matches.
.vscode/*
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
